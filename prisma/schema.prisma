// This is your Prisma schema file
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================
// User
// ==========================

model User {
  id                        Int       @id @default(autoincrement())
  email                     String    @unique
  name                      String?
  createdAt                 DateTime  @default(now())

  deletionRequestedAt       DateTime?
  deletionLinkExpiresAt     DateTime?
  deletedAt                 DateTime?
  purgeAfter                DateTime?

  accounts                  Account[]
  assets                    Asset[]
  investments               Investment[]
  pet                       Pet?

  friends1                  Friendship[] @relation("Friend1")
  friends2                  Friendship[] @relation("Friend2")
}

// ==========================
// Accounts
// ==========================

model Account {
  id            Int      @id @default(autoincrement())
  name          String
  balance       Float    @default(0)

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        Int

  transactions  Transaction[]
}

// ==========================
// Categories
// ==========================

model Category {
  id          String   @id @default(cuid())
  name        String
  type        String

  icon        String
  emoji       String?
  color       String
  description String?

  isDefault   Boolean  @default(true)
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactions Transaction[]

  @@unique([name, type], name: "name_type")
}

// ==========================
// Transactions
// ==========================

model Transaction {
  id            Int        @id @default(autoincrement())

  account       Account?   @relation(fields: [accountId], references: [id], onDelete: SetNull)
  accountId     Int?

  category      Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId    String?

  amount        Float
  date          DateTime   @default(now())
  notes         String?
}

// ==========================
// Assets
// ==========================

model Asset {
  id            Int      @id @default(autoincrement())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        Int

  name          String
  type          String
  value         Float
  acquired      DateTime?
}

// ==========================
// Investments
// ==========================

model Investment {
  id            Int      @id @default(autoincrement())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        Int

  name          String
  type          String
  amount        Float
  quantity      Float?
  dateAcquired  DateTime?
}

// ==========================
// Pet (Gamification)
// ==========================

model Pet {
  id            Int      @id @default(autoincrement())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        Int      @unique

  name          String
  xp            Int      @default(0)
  level         Int      @default(1)
  lastFed       DateTime?
}

// ==========================
// Friends
// ==========================

model Friendship {
  id            Int      @id @default(autoincrement())

  user1         User     @relation("Friend1", fields: [user1Id], references: [id], onDelete: Cascade)
  user1Id       Int

  user2         User     @relation("Friend2", fields: [user2Id], references: [id], onDelete: Cascade)
  user2Id       Int

  status        String
}